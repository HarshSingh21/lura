{
  "clientId": "lura-app-edge",
  "name": "Lura app (e2e short tokens)",
  "description": "Created by e2e/edge.sh for the edge-sync suite only: lura-app with 60 s access tokens, so a run outlives several token lifetimes. Safe to delete; the script recreates it.",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": true,
  "bearerOnly": false,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "consentRequired": false,
  "fullScopeAllowed": true,
  "redirectUris": ["http://localhost:8096/*"],
  "webOrigins": ["+"],
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "access.token.lifespan": "60",
    "post.logout.redirect.uris": "http://localhost:8096/*"
  },
  "protocolMappers": [
    {
      "name": "lura-api-audience",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "consentRequired": false,
      "config": {
        "included.client.audience": "lura-api",
        "access.token.claim": "true",
        "id.token.claim": "false",
        "introspection.token.claim": "true",
        "lightweight.claim": "false"
      }
    }
  ]
}
